{
  "expo": {
    "name": "CrisPlants",
    "slug": "cris-plants",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crisplants",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cristopher.crisplants",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cristopher.crisplants",
      "adaptiveIcon": {
        "backgroundColor": "#1F5C39",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F5C39",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "CrisPlants usa la cámara para fotografiar e identificar plantas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CrisPlants accede a tus fotos para identificar plantas desde la galería."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
